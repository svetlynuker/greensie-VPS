# Greensie – konfigurace webového serveru Caddy
# Caddy si na těchto adresách sám vytáhne a obnovuje HTTPS certifikát (Let's Encrypt).

# Vhosty dalších projektů na tomto serveru (CRM Tlaková četa aj.).
# POZOR: tento import musí zůstat, install.sh tímto souborem přepisuje /etc/caddy/Caddyfile.
import /etc/caddy/sites/*.caddy

# Appka je dostupná pod oběma jmény:
#   app.greensie.cz          – hlavní adresa (DNS A záznam míří na tento server)
#   167-235-254-188.sslip.io – původní adresa, ponechána kvůli starým odkazům
#                              a už registrovaným Google Drive webhookům
app.greensie.cz, 167-235-254-188.sslip.io {
	# Komprese odpovědí
	encode zstd gzip

	# Vše, co začíná /api/, jde na backend (FastAPI na portu 8000).
	# handle_path odřízne "/api" z cesty, takže /api/auth/login -> /auth/login.
	handle_path /api/* {
		reverse_proxy localhost:8000
	}

	# ---- statický frontend (React build) ----
	# Cache se řeší dvěma oddělenými `handle` bloky, ne matchery na jednom
	# `header`: `handle` bloky se vyhodnocují v napsaném pořadí a vzájemně se
	# vylučují, takže je jednoznačné, co dostane jakou hlavičku.
	#
	# Vite dává do názvů souborů v /assets/ hash obsahu, takže nová verze má
	# vždycky nový název a smí se cachovat natrvalo.
	handle /assets/* {
		root * /var/www/greensie
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Všechno ostatní (index.html i hluboké odkazy, které na něj padají přes
	# try_files) se cachovat NESMÍ. Bez Cache-Control si prohlížeč index.html
	# podle vlastní heuristiky drží klidně hodiny, přečte z něj STARÝ hash
	# bundlu a uživateli po nasazení pořád svítí předchozí verze appky.
	# Přesně na tohle Dan narazil 6. 8. 2026 u dlaždice odkupu baterie: server
	# servíroval nový kód, prohlížeč kreslil starý.
	#
	# try_files zajistí, že odkazy uvnitř appky (React Router) fungují po obnovení stránky.
	handle {
		root * /var/www/greensie
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		# Prohlížeč si zapamatuje, že sem chodí jen přes HTTPS.
		Strict-Transport-Security "max-age=31536000"
		# Interní appka nemá co dělat ve výsledcích vyhledávačů.
		X-Robots-Tag "noindex, nofollow"
	}
}
