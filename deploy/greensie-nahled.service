[Unit]
Description=Greensie NÁHLED (FastAPI / uvicorn, port 8001, kopie databáze)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=dan
Group=dan
WorkingDirectory=/home/dan/projects/greensie-nahled/backend
# Sdílíme venv s hlavní instalací — závislosti jsou stejné a `update.sh` ho
# udržuje aktuální. Kód se ale bere z náhledového klonu (WorkingDirectory).
EnvironmentFile=/home/dan/projects/greensie-nahled/.env
ExecStart=/home/dan/projects/greensie-app/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
